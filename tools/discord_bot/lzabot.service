[Unit]
Description=LZ&A Helper Discord bot (online status + closes fixed posts on release)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/lzabot
Environment=PYTHONPATH=%h/lzabot/deps
ExecStart=/usr/bin/python3 -u %h/lzabot/lzabot.py
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
