# Game files and keys: NEVER commit
*.xci
*.nsp
*.nca
*.nso
*.keys
prod.keys
title.keys
extracted/
extracted-*/
generated/
generated-*/

# Build (the built game library is recompiled game code: never commit or share it)
build/

# Local reference clones and tool environments
reference/
tools/bin/
tools/venv/
.venv/
logs/

# Made by the runtime while running (saves, shader caches, local settings)
cache/
save/
larecomp.ini
*.log
mods/

# Logs the NVIDIA driver writes to the working folder
NVIDIA Corporation/
# The Switch's system fonts, from your own console (fonts/README.md)
fonts/*.bfttf
fonts/*.ttf

__pycache__/
play.log
play-prev.log

# Plugins dropped in by the player or `make steamrelay` (the source is contrib/)
plugins/
